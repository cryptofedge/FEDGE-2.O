# FEDGE 2.O bot settings. Copy this file to .env and fill it in.
# .env is git-ignored; never commit real keys.

# ── Required ──────────────────────────────────────────────────────────────────
# Gemini answers every chat and Lyria makes the songs: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# WhatsApp numbers allowed to use VIDEO and to get MEMORY.md / USER.md in replies.
# Digits only, comma-separated (e.g. 19175551234,13475550000). If the bot window shows
# your chat as ...@lid, add those digits too. Empty = nobody.
FEDGE_ADMINS=

# ── Optional ──────────────────────────────────────────────────────────────────
# Chat model. Defaults to gemini-pro-latest; gemini-flash-latest is faster.
GEMINI_MODEL=

# ElevenLabs voice notes. Without a key the bot replies with text only.
ELEVEN_API_KEY=
# Defaults to FEDGE's voice.
ELEVEN_VOICE_ID=

# ── Video studio (VIDEO <game>) ── see studio/README.md ─────────────────────
# Where OpenMontage is installed. Defaults to ../OpenMontage or ~/OpenMontage.
OPENMONTAGE_DIR=
# Python command. Defaults to python on Windows, python3 elsewhere.
PYTHON=
